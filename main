from Ida import *
from Yeejing import *
from Haikal import *
from main_codes import *
from inventory import *

import sys

from PyQt6.QtWidgets import *

from member1.page1 import *
from member2.page2 import *

class MainWindow(QMainWindow):
    """The main container window hosting the QStackedWidget."""
    def __init__(self):
        super().__init__()
        self.setWindowTitle("PyQt Multi-Page Application")
        self.resize(400, 300)
        
        # Initialize the stack container
        self.stacked_widget = QStackedWidget()
        
        # Create instances of our pages, passing the stacked widget as a controller
        self.page1 = Window(self.stacked_widget)
        self.page2 = CalendarMainWindow(self.stacked_widget)
        
        # Add pages to the stack
        self.stacked_widget.addWidget(self.page1)
        self.stacked_widget.addWidget(self.page2)
        
        # Set the stacked widget as the central widget of the main window
        self.setCentralWidget(self.stacked_widget)

if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = MainWindow()
    window.show()
    sys.exit(app.exec())
